# DeepSeek Harness (dsh) — local-only, single-user.
# Copy to .env and adjust; .env is git-ignored.

TZ=Asia/Tokyo

# dsh release (npm dist-tag "latest" as of 2026-11-22). Bump to update.
DSH_VERSION=0.2.2-rc.5

# Host port for the Web UI (bound to 127.0.0.1 only).
DSH_HOST_PORT=49175
# Listener port inside the container (keep in sync with the compose mapping).
DSH_PORT=3080

# Local LiteLLM gateway on ai-backend — the model route and default model.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=ayyylmao
DSH_MODEL=swol-doge

# Permission preset: read-only | workspace-write | danger-full-access
DSH_PERMISSION_MODE=workspace-write

# Optional tailscale exposure (see docker-compose.yml header):
#DSH_PUBLIC_URL=https://<device>.<tailnet>.ts.net:8445/
#DSH_TRUSTED_HOSTS=<device>.<tailnet>.ts.net

# Local web search via your Search Gateway MCP server (1 = on, 0 = off).
DSH_MCP_SEARCH_GATEWAY=1
DSH_MCP_SEARCH_GATEWAY_URL=http://search-gateway:8080/mcp
SEARCH_GATEWAY_API_KEY=
